# ---------------------------------------------------------------
# MindWell environment configuration — copy to ".env" and fill in.
# (This project also works with plain environment variables.)
# ---------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Optional: AI-powered recommendations & chat -----------------
# When set, MindWell calls an OpenAI-compatible chat API for
# personalized suggestions and assistant replies.
# When NOT set, the app runs in "Guided support" mode using the
# built-in recommendation engine (clearly labeled in the UI).
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
